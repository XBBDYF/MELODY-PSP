{
  "schema": 1,
  "id": "eco",
  "name": "ECO 轻量省电",
  "author": "MELODY",
  "version": "2.0",
  "description": "皮肤接管省电222MHz/60秒息屏，性能设置锁定；支持四种配色。退出该皮肤恢复手动设置。",
  "dark": true,
  "colors": {
    "background": "#000000",
    "panel": "#000000",
    "panel2": "#000000",
    "text": "#DDDDDD",
    "secondary": "#AAAAAA",
    "muted": "#777777",
    "line": "#333333",
    "accent": "#66CC99",
    "hot": "#66CC99",
    "row": "#111111",
    "white": "#FFFFFF",
    "black": "#000000",
    "success": "#66CC99",
    "warning": "#CC9955",
    "shadow": "#000000"
  },
  "script": "skin.lua",
  "preferences": [
    {
      "id": "color_mode",
      "label": "界面颜色",
      "type": "choice",
      "options": [
        "深黑绿",
        "纸白蓝",
        "深海蓝",
        "暖灰橙"
      ],
      "default": 0
    }
  ],
  "power_profile": "eco"
}

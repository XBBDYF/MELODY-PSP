{
  "schema": 1,
  "id": "eco",
  "name": "ECO 轻量省电",
  "author": "MELODY",
  "version": "1.0",
  "description": "无动画、无封面；省电/背光超时/SoC时钟可在主题设置调整，MV自动恢复性能档",
  "dark": true,
  "colors": {
    "background": "#000000",
    "panel": "#000000",
    "panel2": "#000000",
    "text": "#DDDDDD",
    "secondary": "#AAAAAA",
    "muted": "#777777",
    "line": "#333333",
    "accent": "#66CC99",
    "hot": "#66CC99",
    "row": "#111111",
    "white": "#FFFFFF",
    "black": "#000000",
    "success": "#66CC99",
    "warning": "#CC9955",
    "shadow": "#000000"
  },
  "script": "skin.lua",
  "preferences": [
    {
      "id": "system_eco",
      "label": "程序省电模式",
      "type": "toggle",
      "default": 0
    },
    {
      "id": "system_timeout",
      "label": "自动息屏时间",
      "type": "choice",
      "options": [
        "跟随系统",
        "30秒",
        "60秒",
        "120秒",
        "300秒",
        "常亮"
      ],
      "default": 0
    },
    {
      "id": "system_clock",
      "label": "SoC时钟",
      "type": "choice",
      "options": [
        "自动",
        "222MHz",
        "266MHz",
        "333MHz"
      ],
      "default": 0
    }
  ]
}
